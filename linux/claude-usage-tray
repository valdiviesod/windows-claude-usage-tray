def theme_colors():
    base = {
        "background": "#282828", "foreground": "#d4be98", "accent": "#7daea3",
        "color1": "#ea6962", "color2": "#a9b665", "color3": "#d8a657",
    }
    try:
        import tomllib
        base.update({k: v for k, v in tomllib.loads(THEME_COLORS.read_text()).items() if isinstance(v, str)})
    except (OSError, ValueError, ImportError):
        pass
    return base


