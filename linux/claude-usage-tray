def ensure_statusline(slot):
    """Hace que el perfil de esta cuenta reporte sus limites a nuestro helper."""
    cdir = config_dir(slot)
    cdir.mkdir(parents=True, exist_ok=True)
    path = cdir / "settings.json"
    root = read_json(path, {})
    if not isinstance(root, dict):
        root = {}
    desired = {
        "type": "command",
        "command": f"{shlex.quote(str(SELF))} statusline {slot}",
        "refreshInterval": 5,
    }
    if root.get("statusLine") == desired:
        return
    root["statusLine"] = desired
    path.write_text(json.dumps(root, indent=2))


def parse_auth_status(stdout):
    i = stdout.find("{")
    if i < 0:
        raise ValueError("respuesta vacía de claude auth status")
    return json.loads(stdout[i:])


def check_auth(slot):
    """Pregunta al `claude` oficial quien esta conectado y lo guarda en identity.json."""
    prev = read_json(apath(slot, "identity.json"), {}) or {}
    claude = find_claude()
    if not claude:
        write_atomic(apath(slot, "identity.json"), {**prev, "connection": "error",
                                                    "error": "Claude Code no está instalado", "checked_at": now_secs()})
        return
    config_dir(slot).mkdir(parents=True, exist_ok=True)
    try:
        out = subprocess.run([claude, "auth", "status"], env=claude_env(slot), stdin=subprocess.DEVNULL,
                             capture_output=True, text=True, timeout=25).stdout
        st = parse_auth_status(out)
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        # No tumbamos una sesion buena por un fallo puntual
        conn = prev.get("connection", "error")
        write_atomic(apath(slot, "identity.json"), {**prev, "connection": conn if conn == "connected" else "error",
                                                    "error": f"No se pudo verificar la sesión: {e}",
                                                    "checked_at": now_secs()})
        return
    if st.get("loggedIn"):
        if st.get("authMethod") != "claude.ai":
            ident = {"connection": "error", "error": "Solo cuentas Claude Pro/Max (claude.ai)"}
        else:
            ident = {"connection": "connected", "email": st.get("email"),
                     "plan": st.get("subscriptionType"), "error": None}
            ensure_statusline(slot)
    else:
        was = prev.get("connection") in ("connected", "expired")
        ident = {"connection": "expired" if was else "disconnected", "email": prev.get("email") if was else None,
                 "plan": prev.get("plan") if was else None,
                 "error": "La sesión expiró." if was else None}
    ident["checked_at"] = now_secs()
    write_atomic(apath(slot, "identity.json"), ident)
    if ident["connection"] == "connected":
        apath(slot, "connecting").unlink(missing_ok=True)


def probe(slot):
    """Una peticion minima real a traves del binario oficial; lee rate_limit_event."""
    claude = find_claude()
    if not claude:
        raise RuntimeError("Claude Code no está instalado")
    work = account_dir(slot) / "work"
    work.mkdir(parents=True, exist_ok=True)
    write_atomic(apath(slot, "busy"), now_secs() + 100)
    try:
        out = subprocess.run(
            [claude, "-p", ".", "--model", "haiku", "--output-format", "stream-json", "--verbose",
             "--max-turns", "1", "--no-session-persistence"],
            env=claude_env(slot), cwd=work, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=90,
        ).stdout
    except (OSError, subprocess.TimeoutExpired) as e:
        raise RuntimeError(f"claude no respondió: {e}")
    finally:
        apath(slot, "busy").unlink(missing_ok=True)
    snap = parse_probe(out, now_secs())
    if not snap:
        raise RuntimeError("claude no devolvió datos de límite (¿plan sin límites de suscripción?)")
    write_atomic(apath(slot, "probe.json"), snap)
    return snap


# --------------------------------------------------------------------------- #
# Comandos de usuario                                                          #
# --------------------------------------------------------------------------- #

def cmd_statusline(slot_arg):
    try:
        slot = int(slot_arg)
    except ValueError:
        return 0
    if slot not in SLOTS:
        return 0
    env_dir = os.environ.get("CLAUDE_CONFIG_DIR", "")
    if env_dir and os.path.realpath(env_dir) != os.path.realpath(config_dir(slot)):
        return 0  # nunca escribir sobre otra cuenta
    snap = parse_statusline(sys.stdin.read(1 << 20), now_secs())
    if snap:
        write_atomic(apath(slot, "usage.json"), snap)
    return 0


def cmd_connect(slot):
    claude = find_claude()
    if not claude:
        notify("Claude Code no está instalado", "Instálalo primero (claude.ai/download).", urgency="critical")
        return 1
    ensure_statusline(slot)
    write_atomic(apath(slot, "connecting"), now_secs() + 300)
    cfg = shlex.quote(str(config_dir(slot)))
    script = (
        f"unset {' '.join(SCRUBBED_ENV)}; export CLAUDE_CONFIG_DIR={cfg}; "
        f"echo 'Inicia sesión con la cuenta que quieres usar como cuenta {slot} ({LABELS[slot]}).'; echo; "
        f"{shlex.quote(claude)} auth login --claudeai; "
        f"{shlex.quote(str(SELF))} refresh; echo; echo 'Listo. Puedes cerrar esta ventana.'; sleep 3"
    )
    subprocess.Popen(
        ["setsid", "uwsm-app", "--", "xdg-terminal-exec", "--app-id=org.omarchy.terminal",
         f"--title=Conectar Claude · {LABELS[slot]}", "-e", "bash", "-c", script],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True,
    )
    signal_daemon()
    return 0


def cmd_disconnect(slot):
    claude = find_claude()
    if claude:
        subprocess.run([claude, "auth", "logout"], env=claude_env(slot), stdin=subprocess.DEVNULL,
                       capture_output=True, timeout=25)
    for name in ("usage.json", "probe.json", "identity.json", "alerts.json", "connecting", "probe_meta.json"):
        apath(slot, name).unlink(missing_ok=True)
    signal_daemon()
    return 0


def cmd_probe(slot):
    try:
        probe(slot)
        write_atomic(apath(slot, "probe_meta.json"), {"last_try": now_secs(), "fails": 0})
    except RuntimeError as e:
        ident = read_json(apath(slot, "identity.json"), {}) or {}
        write_atomic(apath(slot, "identity.json"), {**ident, "error": str(e)})
        signal_daemon()
        return 1
    ident = read_json(apath(slot, "identity.json"), {}) or {}
    if ident.get("error"):
        write_atomic(apath(slot, "identity.json"), {**ident, "error": None})
    signal_daemon()
    return 0


def cmd_run(slot, args):
    claude = find_claude()
    if not claude:
        print("claude no encontrado", file=sys.stderr)
        return 1
    ensure_statusline(slot)
    os.execve(claude, [claude, *args], claude_env(slot))


def notify(title, body, urgency="normal"):
    try:
        subprocess.Popen(["notify-send", "-a", "Claude Usage", "-u", urgency, "-i", "dialog-information", title, body],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass


