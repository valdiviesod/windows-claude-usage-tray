def slot_arg(argv, i=2):
    try:
        s = int(argv[i])
    except (IndexError, ValueError):
        sys.exit(f"uso: {APP} {argv[1]} <1|2>")
    if s not in SLOTS:
        sys.exit("la cuenta debe ser 1 o 2")
    return s


def main(argv):
    cmd = argv[1] if len(argv) > 1 else "popup"
    if cmd == "statusline":
        return cmd_statusline(argv[2] if len(argv) > 2 else "")
    if cmd == "daemon":
        Daemon().run()
        return 0
    if cmd == "popup":
        return cmd_popup()
    if cmd == "connect":
        return cmd_connect(slot_arg(argv))
    if cmd == "disconnect":
        return cmd_disconnect(slot_arg(argv))
    if cmd == "probe":
        return cmd_probe(slot_arg(argv))
    if cmd == "run":
        return cmd_run(slot_arg(argv), argv[3:])
    if cmd == "refresh":
        signal_daemon()
        return 0
    if cmd == "status":
        print(json.dumps(build_views(), indent=2, ensure_ascii=False))
        return 0
    print(__doc__)
    return 0 if cmd in ("-h", "--help", "help") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
