ICON = "\U000f1719"  # nf-md-robot


def span(color, text):
    return f"<span foreground='{color}'>{text}</span>"


def waybar_payload(views, now, colors):
    warn, bad = colors["color3"], colors["color1"]
    conn = [v for v in views if v["connection"] == "connected"]
    if not conn:
        connecting = any(v["connection"] == "connecting" for v in views)
        text = ICON
        tip = "<b>Claude Usage</b>\n" + (
            "Completa el inicio de sesión en la ventana que se abrió…" if connecting
            else "Sin cuentas vinculadas\n<i>Clic para vincular tu cuenta</i>")
        return {"text": text, "tooltip": tip, "class": ["disconnected"], "alt": "disconnected"}

    parts, lines = [], ["<b>Claude Usage</b>"]
    worst = "available"
    rank = {"available": 0, "no_data": 0, "near_limit": 1, "exhausted": 2}
    for v in conn:
        st = v["status"]
        if rank.get(st, 0) > rank[worst]:
            worst = st
        w = (v["usage"] or {}).get("five_hour")
        if w:
            t = pct(w["used_pct"])
            parts.append(span(bad, t) if st == "exhausted" else span(warn, t) if st == "near_limit" else t)
        else:
            parts.append("–")
        who = v["email"] or v["label"]
        lines.append(f"\n<b>{who}</b>  <small>{v['label']}{' · ' + fmt_plan(v['plan']) if v['plan'] else ''}</small>")
        if w:
            lines.append(f"  5 h      <b>{pct(w['used_pct'])}</b>  · reinicia en {fmt_short(w['resets_at'] - now)}")
            wk = v["usage"].get("seven_day")
            if wk:
                lines.append(f"  Semanal  <b>{pct(wk['used_pct'])}</b>  · reinicia en {fmt_short(wk['resets_at'] - now)}")
        else:
            lines.append("  No disponible — usa Claude Code o consulta desde el panel")
    for v in views:
        if v["connection"] == "expired":
            lines.append(f"\n<i>{v['label']}: sesión expirada</i>")
    lines.append("\n<i>Clic: panel · Clic derecho: actualizar</i>")
    cls = {"available": "ok", "no_data": "nodata", "near_limit": "warning", "exhausted": "critical"}[worst]
    first = (conn[0]["usage"] or {}).get("five_hour")
    return {
        "text": f"{ICON} <span size='90%'>" + " ".join(parts) + "</span>",
        "tooltip": "\n".join(lines),
        "class": [cls],
        "alt": worst,
        "percentage": round(first["used_pct"]) if first else 0,
    }


class Daemon:
    def __init__(self):
        self.wake = threading.Event()
        self.force = False
        self.inflight = set()
        self.lock = threading.Lock()
        self.last_auth = {}
        self.last_line = None

    def on_usr1(self, *_):
        self.force = True
        self.wake.set()

    # -- trabajo en segundo plano --
    def spawn(self, key, fn):
        with self.lock:
            if key in self.inflight:
                return
            self.inflight.add(key)

        def run():
            try:
                fn()
            except Exception:
                pass
            finally:
                with self.lock:
                    self.inflight.discard(key)
                self.wake.set()

        threading.Thread(target=run, daemon=True).start()

    def maybe_probe(self, slot, settings, now):
        meta = read_json(apath(slot, "probe_meta.json"), {}) or {}
        interval = settings["probe_interval_mins"] * 60
        backoff = min(interval * (2 ** min(meta.get("fails", 0), 6)), 1800)
        if now - meta.get("last_try", 0) < max(interval, backoff):
            return
        # Si Claude Code reporto algo reciente, no gastamos cuota
        for name in ("usage.json", "probe.json"):
            s = live(read_json(apath(slot, name)), now)
            if s and now - s["captured_at"] < interval:
                return

        def job():
            try:
                probe(slot)
                write_atomic(apath(slot, "probe_meta.json"), {"last_try": now_secs(), "fails": 0})
            except RuntimeError:
                m = read_json(apath(slot, "probe_meta.json"), {}) or {}
                write_atomic(apath(slot, "probe_meta.json"),
                             {"last_try": now_secs(), "fails": m.get("fails", 0) + 1})

        self.spawn(("probe", slot), job)

    def check_alerts(self, view, settings, now):
        if not settings["notifications"]:
            return
        w = (view["usage"] or {}).get("five_hour")
        if not w:
            return
        mem = read_json(apath(view["slot"], "alerts.json"), None)
        same = mem and abs(mem["resets_at"] - w["resets_at"]) < 600
        prev = mem["level"] if same else 0
        level = max([l for l in ALERT_LEVELS if w["used_pct"] >= l], default=0)
        write_atomic(apath(view["slot"], "alerts.json"), {"resets_at": w["resets_at"], "level": max(level, prev)})
        if level > prev:
            who = view["email"] or view["label"]
            if level >= 100:
                notify(f"Claude · {view['label']} agotado", f"{who}: límite de 5 h alcanzado. Reinicia en {fmt_short(w['resets_at'] - now)}.", "critical")
            else:
                notify(f"Claude · {view['label']} al {level}%", f"{who}: usaste {pct(w['used_pct'])} de tu ventana de 5 h. Reinicia en {fmt_short(w['resets_at'] - now)}.")

    def emit(self, payload):
        line = json.dumps(payload, ensure_ascii=False)
        if line == self.last_line:
            return
        self.last_line = line
        try:
            sys.stdout.write(line + "\n")
            sys.stdout.flush()
        except (BrokenPipeError, OSError):
            os._exit(0)  # Waybar se reinicio: este daemon sobra

    def run(self):
        signal.signal(signal.SIGUSR1, self.on_usr1)
        signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
        colors = theme_colors()
        while True:
            now = now_secs()
            settings = load_settings()
            connecting = False
            for slot in SLOTS:
                is_connecting = (read_json(apath(slot, "connecting"), 0) or 0) > now
                connecting |= is_connecting
                ident = read_json(apath(slot, "identity.json"), {}) or {}
                due = (self.force or now - self.last_auth.get(slot, 0) >= AUTH_RECHECK_SECS
                       or (is_connecting and now - self.last_auth.get(slot, 0) >= 3))
                if due:
                    self.last_auth[slot] = now
                    before = ident.get("connection")

                    def job(s=slot, b=before):
                        check_auth(s)
                        after = (read_json(apath(s, "identity.json"), {}) or {}).get("connection")
                        if after == "connected" and b != "connected":
                            # Recien vinculada: primera lectura inmediata
                            try:
                                probe(s)
                            except RuntimeError:
                                pass

                    self.spawn(("auth", slot), job)
                elif ident.get("connection") == "connected" and settings["probe_enabled"]:
                    self.maybe_probe(slot, settings, now)
            self.force = False

            views = build_views(now)
            for v in views:
                if v["connection"] == "connected":
                    self.check_alerts(v, settings, now)
            self.emit(waybar_payload(views, now, colors))
            self.wake.wait(3 if connecting else TICK_SECS)
            self.wake.clear()


