    # --- actualización ---
    @staticmethod
    def _tone(p):
        return "bad" if p >= 100 else "warn" if p >= NEAR_LIMIT else ""

    def _set_tone(self, widget, tone):
        for t in ("warn", "bad"):
            widget.remove_css_class(t)
        if tone:
            widget.add_css_class(tone)

    def update(self, v, now):
        self.view = v
        conn = v["connection"]
        connected = conn == "connected"
        email = v["email"]
        self.avatar.set_label(email[0].upper() if email else "")
        (self.avatar.remove_css_class if email else self.avatar.add_css_class)("off")
        self.name.set_label(email if email else f"Cuenta {v['slot']} · {v['label']}")
        plan = fmt_plan(v["plan"])
        self.sub.set_label(v["label"] + (f" · {plan}" if plan and connected else ""))
        self.menu_btn.set_visible(connected or conn == "expired")
        if not (connected or conn == "expired"):
            self.menu.set_reveal_child(False)

        chip_map = {"available": "Disponible", "near_limit": "Cerca del límite", "exhausted": "Agotado",
                    "no_data": "Sin datos", "disconnected": "Desconectada"}
        text = ("Sesión expirada" if conn == "expired" else "Conectando…" if conn == "connecting"
                else chip_map[v["status"]])
        self.chip.set_label(text)
        for c in chip_map:
            self.chip.remove_css_class(c)
        if conn in ("connected",):
            self.chip.add_css_class(v["status"])

        if conn == "connecting":
            self.stack.set_visible_child_name("wait")
            return
        if not connected:
            expired = conn == "expired"
            self.err.set_visible(bool(expired or v["error"]))
            self.err.set_label(v["error"] or "La sesión expiró.")
            self.connect_btn.set_label(("  Reconectar Claude" if expired else "  Vincular mi cuenta de Claude"))
            self.connect_btn.set_sensitive(find_claude() is not None)
            self.connect_hint.set_label(
                "El inicio de sesión lo hace Claude Code (navegador), no esta app." if find_claude()
                else "Requiere Claude Code instalado. El inicio de sesión lo hace Claude Code, no esta app.")
            self.stack.set_visible_child_name("connect")
            return

        u = v["usage"] or {}
        five, week = u.get("five_hour"), u.get("seven_day")
        busy = v["busy"]
        lbl = "  Consultando…" if busy else "  Consultar ahora"
        if not five:
            self.nodata_btn.set_label(lbl)
            self.nodata_btn.set_sensitive(not busy)
            self.stack.set_visible_child_name("nodata")
            return
        tone = self._tone(five["used_pct"])
        self.big.set_label(pct(five["used_pct"]))
        self._set_tone(self.big, tone)
        self.left_lbl.set_label(f"{pct(max(0, 100 - five['used_pct']))} restante")
        self.reset_lbl.set_label(f"Reinicia en {fmt_remaining(five['resets_at'] - now)}")
        self.bar.set_fraction(five["used_pct"] / 100)
        self._set_tone(self.bar, tone)
        self.clock_lbl.set_label(f"Se reinicia a las {fmt_clock(five['resets_at'], now)}")
        self.week_box.set_visible(bool(week))
        if week:
            self.week_lbl.set_label(f"{pct(week['used_pct'])} · reinicia en {fmt_remaining(week['resets_at'] - now)}")
            self.week_bar.set_fraction(week["used_pct"] / 100)
            self._set_tone(self.week_bar, self._tone(week["used_pct"]))
        src = "consulta directa" if u.get("source") == "probe" else "Claude Code"
        self.age_lbl.set_label(f"Dato de {fmt_ago(u['captured_at'], now)} · {src}")
        self.refresh_btn.set_label("" if busy else "")
        self.refresh_btn.set_tooltip_text("Consultar ahora (consume una petición mínima)")
        self.refresh_btn.set_sensitive(not busy)
        self.stack.set_visible_child_name("data")


class Popup:
    def __init__(self):
        import gi
        gi.require_version("Gtk", "4.0")
        gi.require_version("Gtk4LayerShell", "1.0")
        from gi.repository import Gdk, GLib, Gtk
        from gi.repository import Gtk4LayerShell as LS
        self.Gtk, self.GLib, self.Gdk, self.LS = Gtk, GLib, Gdk, LS
        self.cards = {}
        self.last_sig = None

    def run_cmd(self, cmd, slot):
        subprocess.Popen([str(SELF), cmd, str(slot)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        # Feedback inmediato en la tarjeta mientras el comando arranca
        if cmd == "probe":
            write_atomic(apath(slot, "busy"), now_secs() + 100)
        if cmd == "connect":
            # Cerrar el panel: es una capa overlay a pantalla completa con teclado
            # exclusivo y taparia la terminal del login.
            write_atomic(apath(slot, "connecting"), now_secs() + 300)
            self.app.quit()
            return
        self.GLib.timeout_add(250, self.tick)

    def build(self, app):
        self.app = app
        Gtk, LS = self.Gtk, self.LS
        css = Gtk.CssProvider()
        css.load_from_string(popup_css(theme_colors()))
        Gtk.StyleContext.add_provider_for_display(self.Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_USER)
        win = Gtk.ApplicationWindow(application=app)
        win.add_css_class("backdrop-win")
        LS.init_for_window(win)
        LS.set_namespace(win, APP)
        LS.set_layer(win, LS.Layer.OVERLAY)
        LS.set_keyboard_mode(win, LS.KeyboardMode.EXCLUSIVE)
        for edge in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
            LS.set_anchor(win, edge, True)

        backdrop = Gtk.Box()
        backdrop.set_hexpand(True)
        backdrop.set_vexpand(True)
        click = Gtk.GestureClick()
        click.connect("pressed", self.on_backdrop)
        backdrop.add_controller(click)

        self.panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        self.panel.add_css_class("panel")
        self.panel.set_size_request(360, -1)
        self.panel.set_hexpand(True)
        self.panel.set_vexpand(True)
        self.panel.set_halign(Gtk.Align.END)
        self.panel.set_valign(Gtk.Align.START)
        self.panel.set_margin_top(4)
        self.panel.set_margin_end(4)

        head = Gtk.Box(spacing=8)
        t = Gtk.Label(label=f"  CLAUDE USAGE", xalign=0)
        t.add_css_class("title")
        t.set_hexpand(True)
        head.append(t)
        rb = Gtk.Button(label="")
        rb.add_css_class("flat")
        rb.set_tooltip_text("Re-verificar sesiones")
        rb.connect("clicked", lambda *_: (signal_daemon(), self.GLib.timeout_add(600, self.tick)))
        head.append(rb)
        self.panel.append(head)

        for slot in SLOTS:
            self.cards[slot] = Card(slot, self)
            self.panel.append(self.cards[slot].root)

        foot = Gtk.Box(spacing=8)
        fl = Gtk.Label(label="Consulta directa automática", xalign=0)
        fl.add_css_class("mute")
        fl.add_css_class("tiny")
        fl.set_hexpand(True)
        fl.set_tooltip_text("Hace una petición mínima cada pocos minutos si Claude Code no reportó datos.\n"
                            "Desactívala si prefieres no gastar nada de cuota.")
        foot.append(fl)
        self.sw = Gtk.Switch()
        self.sw.set_active(load_settings()["probe_enabled"])
        self.sw.connect("notify::active", self.on_switch)
        foot.append(self.sw)
        self.panel.append(foot)

        backdrop.append(self.panel)  # el backdrop es un Box horizontal; el panel usa halign/valign
        win.set_child(backdrop)
        key = Gtk.EventControllerKey()
        key.connect("key-pressed", lambda c, kv, *_: app.quit() if kv == self.Gdk.KEY_Escape else None)
        win.add_controller(key)
        win.present()
        self.tick()
        self.GLib.timeout_add_seconds(1, self.tick)
        self.GLib.timeout_add(30, lambda: self.panel.add_css_class("shown") and False)

    def on_backdrop(self, gesture, _n, x, y):
        # Solo cerrar si el clic cae fuera del panel (sin reclamar el evento,
        # para no cancelar los clics de los botones).
        ok, b = self.panel.compute_bounds(gesture.get_widget())
        if ok and b.get_x() <= x <= b.get_x() + b.get_width() and b.get_y() <= y <= b.get_y() + b.get_height():
            return
        self.app.quit()

    def on_switch(self, sw, _):
        s = load_settings()
        s["probe_enabled"] = sw.get_active()
        save_settings(s)
        signal_daemon()

    def tick(self):
        now = now_secs()
        for v in build_views(now):
            self.cards[v["slot"]].update(v, now)
        return True


def cmd_popup():
    # gtk4-layer-shell debe cargarse antes que libwayland en Python
    lib = "/usr/lib/libgtk4-layer-shell.so"
    if lib not in os.environ.get("LD_PRELOAD", "") and os.path.exists(lib):
        env = dict(os.environ)
        env["LD_PRELOAD"] = (lib + " " + env.get("LD_PRELOAD", "")).strip()
        os.execve(sys.executable, [sys.executable, str(SELF), "popup"], env)

    # Toggle: si ya hay un popup abierto, cerrarlo
    try:
        old = int(POPUP_PIDFILE.read_text())
        if old != os.getpid() and pid_alive(old):
            os.kill(old, signal.SIGTERM)
            return 0
    except (OSError, ValueError):
        pass
    POPUP_PIDFILE.write_text(str(os.getpid()))

    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gtk
    popup = Popup()
    app = Gtk.Application(application_id=None)
    app.connect("activate", popup.build)
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
    try:
        return app.run([])
    finally:
        POPUP_PIDFILE.unlink(missing_ok=True)


