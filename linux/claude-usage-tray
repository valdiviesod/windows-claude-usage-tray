#!/usr/bin/env python3
"""Claude Usage Tray para Omarchy / Waybar.

Port nativo de windows-claude-usage-tray: muestra el uso real (ventana de 5 h y
semanal) de hasta dos cuentas Claude Pro/Max en la barra superior, con un popup
GTK4 tematizado con los colores de Omarchy.

La app NO toca credenciales: el inicio de sesion lo hace el CLI oficial
`claude auth login` dentro de un CLAUDE_CONFIG_DIR aislado por cuenta, y el uso
sale de lo que Claude Code reporta (statusLine) o de una consulta minima opcional.

Subcomandos:
  daemon            proceso para Waybar (imprime una linea JSON por cambio)
  popup             abre/cierra el panel
  connect N         vincula la cuenta N (abre el login oficial)
  disconnect N      cierra sesion de la cuenta N
  probe N           consulta directa ahora (consume una peticion minima)
  refresh           pide al daemon que re-verifique todo
  statusline N      helper que invoca Claude Code (no usar a mano)
  run N [args...]   ejecuta `claude` con el perfil de la cuenta N
  status            imprime el estado actual (depuracion)
"""

import json
import os
import re
import shlex
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

APP = "claude-usage-tray"
SLOTS = (1, 2)
LABELS = {1: "Personal", 2: "Trabajo"}
NEAR_LIMIT = 80.0
ALERT_LEVELS = (80, 95, 100)
AUTH_RECHECK_SECS = 600
TICK_SECS = 15
SELF = Path(os.path.realpath(__file__))

DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / APP
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
PIDFILE = RUNTIME / f"{APP}.pid"
POPUP_PIDFILE = RUNTIME / f"{APP}-popup.pid"
THEME_COLORS = Path.home() / ".config/omarchy/current/theme/colors.toml"

SCRUBBED_ENV = (
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "CLAUDE_CODE_OAUTH_TOKEN",
    "CLAUDE_CODE_USE_BEDROCK",
    "CLAUDE_CODE_USE_VERTEX",
)

DEFAULT_SETTINGS = {
    "notifications": True,
    # Consulta directa automatica: una peticion minima (haiku, 1 turno) cuando
    # Claude Code no ha reportado datos recientes. Consume una pizca de cuota.
    "probe_enabled": True,
    "probe_interval_mins": 5,
}


# --------------------------------------------------------------------------- #
# Rutas y E/S                                                                  #
# --------------------------------------------------------------------------- #

def account_dir(slot):
    return DATA / "accounts" / str(slot)


def config_dir(slot):
    return account_dir(slot) / "claude"


def apath(slot, name):
    return account_dir(slot) / name


def now_secs():
    return int(time.time())


def write_atomic(path, obj):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    tmp.write_text(json.dumps(obj))
    os.replace(tmp, path)


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text())
    except (OSError, ValueError):
        return default


def load_settings():
    s = dict(DEFAULT_SETTINGS)
    s.update({k: v for k, v in (read_json(DATA / "settings.json", {}) or {}).items() if k in s})
    s["probe_interval_mins"] = max(1, min(1440, int(s["probe_interval_mins"] or 5)))
    return s


def save_settings(s):
    write_atomic(DATA / "settings.json", s)


def find_claude():
    for d in os.environ.get("PATH", "").split(os.pathsep):
        p = Path(d) / "claude"
        if d and p.is_file() and os.access(p, os.X_OK):
            return str(p)
    p = Path.home() / ".local/bin/claude"
    return str(p) if p.is_file() else None


def claude_env(slot):
    env = {k: v for k, v in os.environ.items() if k not in SCRUBBED_ENV}
    env["CLAUDE_CONFIG_DIR"] = str(config_dir(slot))
    return env


def signal_daemon():
    """Avisa a todos los daemons (uno por cada barra/monitor)."""
    for d in Path("/proc").iterdir():
        if not d.name.isdigit() or int(d.name) == os.getpid():
            continue
        try:
            argv = (d / "cmdline").read_bytes().split(b"\0")
        except OSError:
            continue
        if any(a.endswith(APP.encode()) for a in argv) and b"daemon" in argv:
            try:
                os.kill(int(d.name), signal.SIGUSR1)
            except OSError:
                pass


def pid_alive(pid, needle=APP):
    try:
        cmd = Path(f"/proc/{pid}/cmdline").read_bytes().decode(errors="ignore")
    except OSError:
        return False
    return needle in cmd


# --------------------------------------------------------------------------- #
# Modelo: snapshots, estado, formato                                           #
# --------------------------------------------------------------------------- #

def parse_window(v, key, resets_key, scale=1.0):
    try:
        used = float(v[key]) * scale
        resets = int(v[resets_key])
    except (TypeError, KeyError, ValueError):
        return None
    if used != used or resets <= 0:
        return None
    return {"used_pct": max(0.0, min(100.0, used)), "resets_at": resets}


def parse_statusline(text, now):
    try:
        limits = json.loads(text)["rate_limits"]
    except (ValueError, KeyError, TypeError):
        return None
    if not isinstance(limits, dict):
        return None
    snap = {
        "captured_at": now,
        "source": "statusline",
        "five_hour": parse_window(limits.get("five_hour"), "used_percentage", "resets_at"),
        "seven_day": parse_window(limits.get("seven_day"), "used_percentage", "resets_at"),
    }
    return snap if snap["five_hour"] or snap["seven_day"] else None


def parse_probe(stdout, now):
    best = None
    for line in stdout.splitlines():
        if "rate_limit_event" not in line:
            continue
        try:
            w = json.loads(line)["rate_limit_info"]["unifiedWindows"]
        except (ValueError, KeyError, TypeError):
            continue
        snap = {
            "captured_at": now,
            "source": "probe",
            # `utilization` es una fraccion 0-1 (verificado en docs/RESEARCH.md del original)
            "five_hour": parse_window(w.get("five_hour"), "utilization", "resetsAt", 100.0),
            "seven_day": parse_window(w.get("seven_day"), "utilization", "resetsAt", 100.0),
        }
        if snap["five_hour"] or snap["seven_day"]:
            best = snap
    return best


def live(snap, now):
    """Descarta ventanas ya reiniciadas: sus numeros ya no son actuales."""
    if not snap:
        return None
    out = dict(snap)
    for k in ("five_hour", "seven_day"):
        w = snap.get(k)
        out[k] = w if w and w["resets_at"] > now else None
    return out if (out["five_hour"] or out["seven_day"]) else None


def newest_usage(slot, now):
    a = read_json(apath(slot, "usage.json"))
    b = read_json(apath(slot, "probe.json"))
    cands = [s for s in (live(a, now), live(b, now)) if s]
    return max(cands, key=lambda s: s["captured_at"]) if cands else None


def compute_status(connection, usage):
    if connection != "connected":
        return "disconnected"
    w = (usage or {}).get("five_hour")
    if not w:
        return "no_data"
    if w["used_pct"] >= 100:
        return "exhausted"
    if w["used_pct"] >= NEAR_LIMIT:
        return "near_limit"
    return "available"


def build_views(now=None):
    now = now or now_secs()
    views = []
    for slot in SLOTS:
        ident = read_json(apath(slot, "identity.json"), {}) or {}
        conn = ident.get("connection", "disconnected")
        connecting = (read_json(apath(slot, "connecting"), 0) or 0) > now
        if connecting and conn != "connected":
            conn = "connecting"
        usage = newest_usage(slot, now) if conn == "connected" else None
        views.append({
            "slot": slot,
            "label": LABELS[slot],
            "connection": conn,
            "email": ident.get("email"),
            "plan": ident.get("plan"),
            "error": ident.get("error"),
            "usage": usage,
            "status": compute_status(conn, usage),
            "busy": (read_json(apath(slot, "busy"), 0) or 0) > now,
        })
    return views


def fmt_remaining(secs):
    s = max(0, int(secs))
    d, h, m, sec = s // 86400, s % 86400 // 3600, s % 3600 // 60, s % 60
    if d:
        return f"{d} d {h} h"
    if h:
        return f"{h} h {m} min"
    if m:
        return f"{m} min {sec} s"
    return f"{sec} s"


def fmt_short(secs):
    s = max(0, int(secs))
    d, h, m = s // 86400, s % 86400 // 3600, s % 3600 // 60
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {m}m"
    return f"{m}m" if m else "<1m"


def fmt_clock(epoch, now):
    t = time.localtime(epoch)
    clock = time.strftime("%H:%M", t)
    if time.strftime("%Y%j", t) == time.strftime("%Y%j", time.localtime(now)):
        return clock
    days = ["lun", "mar", "mié", "jue", "vie", "sáb", "dom"]
    return f"{days[t.tm_wday]} {clock}"


def fmt_ago(epoch, now):
    d = max(0, now - epoch)
    if d < 5:
        return "ahora"
    if d < 60:
        return f"hace {d} s"
    if d < 3600:
        return f"hace {max(1, round(d / 60))} min"
    if d < 86400:
        return f"hace {round(d / 3600)} h"
    return f"hace {round(d / 86400)} d"


def fmt_plan(plan):
    if not plan:
        return None
    known = {"pro": "Pro", "max": "Max", "team": "Team", "enterprise": "Enterprise", "free": "Free"}
    return known.get(plan.lower(), plan.capitalize())


def pct(n):
    return f"{round(n)}%"


